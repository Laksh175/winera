{
  "name": "winera-backend",
  "version": "1.0.0",
  "description": "Winera Website Backend CMS API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:arcade": "node src/scripts/seedArcadeProductsMongo.js",
    "seed:vr": "node src/scripts/seedVrGamesMongo.js",
    "seed:blogs": "node src/scripts/seedBlogsMongo.js",
    "seed:projects": "node src/scripts/seedOnly15DocProjects.js",
    "seed:all": "node src/scripts/seedArcadeProductsMongo.js && node src/scripts/seedVrGamesMongo.js && node src/scripts/seedBlogsMongo.js && node src/scripts/seedOnly15DocProjects.js",
    "upload:cloudinary": "node src/scripts/uploadArcadeToCloudinary.js",
    "sync:json": "node src/scripts/syncJsonFromMongo.js",
    "backup:db": "node src/scripts/backupDatabase.js",
    "restore:db": "node src/scripts/restoreFromBackupDb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
